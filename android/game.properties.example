# Скопируйте в game.properties (он в .gitignore) и укажите адрес сервера игры.
# Клиент из APK работает под этим происхождением, /api и WebSocket идут на сервер.
gameOrigin=https://game.example.com
# Сервера игры нет: APK запускается сразу гостем, аккаунты и Арена скрыты.
# Адрес выше всё равно нужен: под ним живёт локальное сохранение.
offline=false
# Прежний адрес сервера, если он менялся: при первом запуске новой версии сохранения
# из-под него переносятся под gameOrigin (сеть для этого не нужна). Пусто - не переносить.
legacyOrigin=
