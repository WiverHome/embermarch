# Copy this file to .env and fill in real values before starting the server.

# Port the Node.js process listens on. nginx will reverse-proxy to this port.
PORT=4000

# Secret used to sign session JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Keep this secret out of git. Changing it invalidates all existing logins.
JWT_SECRET=change-me-to-a-long-random-value

# Extra origins allowed to call this API (CORS), comma-separated. The game is
# served by this server itself, so its own origin is always allowed: usually empty.
ALLOWED_ORIGINS=

# Path to the SQLite database file (created automatically if missing).
DB_PATH=./data/embermarch.sqlite

# Numeric id of the ONE account allowed into the admin panel (https://<server>/admin).
# Find the id of your account with:  node admin-cli.js find <username>
# Leave empty to disable the admin panel entirely.
ADMIN_USER_ID=
